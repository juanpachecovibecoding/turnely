# Puerto del servidor (por defecto 3000 o el asignado por Render)
PORT=3000

# PIN de acceso al Panel de Administración (por defecto 1234)
ADMIN_PIN=1234

# Google Gemini API Key (También se puede configurar directamente desde el panel admin)
GEMINI_API_KEY=

# URL pública de tu aplicación en Render (ej: https://turnely.onrender.com)
APP_URL=http://localhost:3000

# Base de datos PostgreSQL (Opcional - Supabase / Neon / Render Postgres)
# Si no se proporciona, la app usa almacenamiento local automático en ./data
# DATABASE_URL=postgresql://usuario:password@host:5432/database?sslmode=require
